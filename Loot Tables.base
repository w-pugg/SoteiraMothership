views:
  - type: table
    name: Equipment
    filters:
      and:
        - file.tags.contains("equipment")
    order:
      - file.name
      - tags
      - Designer
      - Range
      - DMG
      - Wound Type
      - Price
    sort:
      - property: Price
        direction: ASC
      - property: tags
        direction: ASC
      - property: Range
        direction: ASC
    cardSize: 170
    imageAspectRatio: 1.15
    columnSize:
      file.name: 272
      note.tags: 318
      note.DMG: 86
      note.Wound Type: 126
      note.Price: 80
